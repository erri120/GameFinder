[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2
tab_width = 2

[{*.yaml,*.yml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
